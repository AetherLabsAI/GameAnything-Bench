# AppArmor profile for the GameAnything-Bench Steam hub container (gab-steam-hub) ONLY.
# Same as Docker's default container profile, plus what Steam's bubblewrap sandbox needs:
# creating user namespaces, mounting inside them, pivot_root. Host-wide settings are NOT changed.
#
# Load (root):   sudo install -m 644 gab-steam-hub.apparmor /etc/apparmor.d/gab-steam-hub
#                sudo apparmor_parser -r -W /etc/apparmor.d/gab-steam-hub
# Remove:        sudo apparmor_parser -R /etc/apparmor.d/gab-steam-hub && sudo rm /etc/apparmor.d/gab-steam-hub
abi <abi/4.0>,
include <tunables/global>

profile gab-steam-hub flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,
  dbus,
  unix,

  # additions over docker-default
  userns,
  mount,
  pivot_root,

  signal (receive) peer=unconfined,
  signal (send,receive) peer=gab-steam-hub,
  ptrace (trace,read,tracedby,readby) peer=gab-steam-hub,

  # same protections as docker-default
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
