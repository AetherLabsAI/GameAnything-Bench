<Project Sdk="Microsoft.NET.Sdk">
  <!-- gab harness mod (GameAnything-Bench): built by the adapter in the sandbox with ModBuildConfig; GamePath / GameModsPath are
       given on the command line (gab/game/stardew_valley/adapter.py). -->
  <PropertyGroup>
    <AssemblyName>GabBridge</AssemblyName>
    <RootNamespace>GabBridge</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableHarmony>true</EnableHarmony>
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>
  <ItemGroup>
    <!-- SMAPI's own Newtonsoft.Json (loaded by SMAPI at run time; not copied into the mod folder) -->
    <Reference Include="Newtonsoft.Json" HintPath="$(GamePath)/smapi-internal/Newtonsoft.Json.dll" Private="false" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.0" />
  </ItemGroup>
</Project>
